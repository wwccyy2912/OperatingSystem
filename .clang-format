# OpSys C code style — matches AGENTS.md conventions:
#   4-space indent, K&R braces, line width <= 100, UTF-8 + LF.
#
# Apply:  clang-format -i <file>
# Check:  clang-format --dry-run -Werror <file>
#
# Excluded from formatting (do NOT run clang-format on these):
#   - user/services/vfs/fs_mem_driver.c   (frozen by project rule, see AGENTS.md)
#   - user/services/term/font.h           (generated font bitmap data)
#   - kernel/include/kernel/panic_font.h  (generated font bitmap data)

# --- Base style ---
Language:        Cpp
BasedOnStyle:    LLVM

# --- Indentation ---
IndentWidth:     4
TabWidth:        4
UseTab:          Never
ContinuationIndentWidth: 4
AccessModifierOffset: -4
IndentCaseLabels: false
IndentGotoLabels: false
NamespaceIndentation: None

# --- Line length ---
ColumnLimit:     100

# --- Braces (K&R / Attach) ---
BreakBeforeBraces: Attach
AllowShortBlocksOnASingleLine: Empty
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false

# --- Alignment ---
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: Consecutive
AlignConsecutiveDeclarations: Consecutive
AlignConsecutiveBitFields: Consecutive
AlignConsecutiveMacros: Consecutive
AlignEscapedNewlines: Left
AlignOperands:   Align
AlignTrailingComments: true

# --- Arguments & parameters ---
AllowAllArgumentsOnNextLine: true
AllowAllParametersOfDeclarationOnNextLine: true
BinPackArguments: false
BinPackParameters: false

# --- Pointers & references ---
PointerAlignment: Right
DerivePointerAlignment: false

# --- Spaces ---
SpaceAfterCStyleCast: false
SpaceBeforeAssignmentOperators: true
SpaceBeforeCaseColon: false
SpaceBeforeParens: ControlStatements
SpaceBeforeSquareBrackets: false
SpaceInEmptyBlock: false
SpaceInEmptyParentheses: false
SpacesInCStyleCastParentheses: false
SpacesInConditionalStatement: false
SpacesInParentheses: false
SpacesInSquareBrackets: false
SpacesBeforeTrailingComments: 1

# --- Include sorting ---
# Preserve original include order — reordering can break logical grouping
# and hidden include dependencies in a freestanding environment.
IncludeBlocks:   Preserve
SortIncludes:    Never

# --- Penalty (tune line-breaking decisions) ---
PenaltyBreakAssignment: 25
PenaltyBreakBeforeFirstCallParameter: 19
PenaltyBreakComment: 300
PenaltyBreakFirstLessLess: 120
PenaltyBreakString: 1000
PenaltyExcessCharacter: 100
PenaltyReturnTypeOnItsOwnLine: 60

# --- Misc ---
AlwaysBreakAfterDefinitionReturnType: None
AlwaysBreakAfterReturnType: None
AlwaysBreakBeforeMultilineStrings: false
AlwaysBreakTemplateDeclarations: No
ConstructorInitializerIndentWidth: 4
Cpp11BracedListStyle: true
FixNamespaceComments: false
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 2
ReflowComments: true
SortUsingDeclarations: true
SpacesInContainerLiterals: false
